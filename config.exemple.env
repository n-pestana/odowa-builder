# Valeurs communes a tous les clients. Rien de secret ici.
# Copier ce fichier en config.env et le remplir. config.env n'est pas versionne.

# Compte ou organisation GitHub qui heberge les depots des clients
PROPRIETAIRE=n-pestana

# Ton login GitHub : proprietaire du code (CODEOWNERS) et destinataire des alertes
LOGIN_NICOLAS=n-pestana

# Ce que le client voit si une alerte n'a pas pu partir
CONTACT_SECOURS="Nicolas - nicolas@exemple.fr - 06 00 00 00 00"

# Compte Cloudflare qui heberge tous les projets Pages
CLOUDFLARE_ACCOUNT_ID=

# Boite qui recoit les messages du formulaire sur les sites de test, et les envois de test en ligne
EMAIL_TEST=

# Adresse d'expedition des formulaires, sur un domaine valide une fois chez Resend
CONTACT_EXPEDITEUR="Formulaire du site <formulaire@ton-domaine.fr>"

# Cle publique du captcha Turnstile (facultatif)
TURNSTILE_SITEKEY=
