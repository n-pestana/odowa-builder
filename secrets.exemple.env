# Secrets communs a tous les clients.
# Copier ce fichier en secrets.env, le remplir, puis : chmod 600 secrets.env
# secrets.env n'est JAMAIS versionne (voir .gitignore) et ne doit jamais etre affiche.

# Jeton d'API Cloudflare limite a "Cloudflare Pages : modification" sur ton compte
CLOUDFLARE_API_TOKEN=

# Cle d'API Resend (envoi des mails des formulaires)
RESEND_API_KEY=

# Cle secrete du captcha Turnstile (facultatif)
TURNSTILE_SECRET=
