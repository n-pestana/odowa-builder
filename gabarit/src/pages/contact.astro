---
import Base from '../layouts/Base.astro';
import Formulaire from '../../noyau/Formulaire.astro';
import entreprise from '../donnees/entreprise.json';
---

<Base
  title="Contact et devis gratuit | Exemple SARL"
  description="Contactez Exemple SARL, plombier chauffagiste à Beauvais, pour un dépannage ou un devis gratuit. Réponse sous 48 heures par téléphone ou par e-mail."
>
  <h1>Nous contacter</h1>
  <p>
    Par téléphone au <a href={`tel:${entreprise.telephone}`}>{entreprise.telephoneAffiche}</a>{' '}
    ({entreprise.horaires.toLowerCase()}), ou avec ce formulaire.
  </p>

  <Formulaire />
</Base>
