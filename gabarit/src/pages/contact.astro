---
import Base from '../layouts/Base.astro';
import Formulaire from '../../noyau/Formulaire.astro';
import entreprise from '../donnees/entreprise.json';
---

<Base
  title={`Contact | ${entreprise.nom}`}
  description={`Écrivez à ${entreprise.nom} avec le formulaire de contact. Nous vous répondons dès que possible.`}
>
  <h1>Nous contacter</h1>
  {entreprise.telephone && (
    <p>
      Par téléphone au <a href={`tel:${entreprise.telephone}`}>{entreprise.telephoneAffiche}</a>{entreprise.horaires && ` (${entreprise.horaires.toLowerCase()})`}, ou avec ce formulaire.
    </p>
  )}

  <Formulaire merci="Merci, votre message est bien parti. Nous vous répondons dès que possible." />
</Base>
