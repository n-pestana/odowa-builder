---
import Base from '../layouts/Base.astro';
import entreprise from '../donnees/entreprise.json';
---

<Base
  title={`Page introuvable | ${entreprise.nom}`}
  description={`Cette page n'existe pas ou n'existe plus. Retournez à l'accueil du site de ${entreprise.nom}.`}
  indexable={false}
>
  <h1>Page introuvable</h1>
  <p>Cette page n'existe pas ou n'existe plus.</p>
  <p><a href="/">Retour à l'accueil</a></p>
</Base>
