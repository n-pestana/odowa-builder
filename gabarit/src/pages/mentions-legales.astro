---
// Le contenu de cette page est sous la responsabilite du client.
// Les coordonnees viennent de src/donnees/entreprise.json : une seule source.
import Base from '../layouts/Base.astro';
import entreprise from '../donnees/entreprise.json';
const { rue, codePostal, ville } = entreprise.adresse;
---

<Base
  title={`Mentions légales | ${entreprise.nom}`}
  description={`Mentions légales du site de ${entreprise.nom} : éditeur du site, hébergeur et informations sur les données personnelles.`}
>
  <h1>Mentions légales</h1>

  <h2>Éditeur du site</h2>
  <p>{entreprise.nom}{rue && `, ${rue}, ${codePostal} ${ville}`}.</p>

  <h2>Hébergeur</h2>
  <p>Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, États-Unis.</p>

  <h2>Données personnelles</h2>
  <p>Les informations envoyées par le formulaire de contact servent uniquement à répondre à votre demande.</p>
</Base>
