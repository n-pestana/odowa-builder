---
// L'habillage du site : en-tete, menu, pied de page, couleurs. Appartient au client.
// Le document HTML (balises pour Google, site de test) vient du noyau : noyau/Page.astro.
// Les pages Markdown passent leurs informations par "frontmatter", les pages .astro par des proprietes.
import Page from '../../noyau/Page.astro';
import entreprise from '../donnees/entreprise.json';

const { title, description, indexable = true } = Astro.props.frontmatter ?? Astro.props;
---

<Page title={title} description={description} indexable={indexable}>
  <header class="entete">
    <a class="marque" href="/">{entreprise.nom}</a>
    <nav aria-label="Menu principal">
      <ul>
        {entreprise.menu.map((entree) => (
          <li><a href={entree.lien}>{entree.titre}</a></li>
        ))}
      </ul>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="pied">
    <p>
      {entreprise.nom}
      {entreprise.adresse.rue && ` · ${entreprise.adresse.rue}, ${entreprise.adresse.codePostal} ${entreprise.adresse.ville}`}
      {entreprise.telephone && <> · <a href={`tel:${entreprise.telephone}`}>{entreprise.telephoneAffiche}</a></>}
    </p>
    <p><a href="/mentions-legales/">Mentions légales</a></p>
  </footer>
</Page>

<style is:global>
  :root {
    --couleur-texte: #1c2430;
    --couleur-fond: #ffffff;
    --couleur-accent: #0b5cad;
    --couleur-doux: #f2f5f9;
    --largeur: 62rem;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--couleur-texte);
    background: var(--couleur-fond);
  }
  a {
    color: var(--couleur-accent);
  }
  .entete,
  main,
  .pied {
    max-width: var(--largeur);
    margin: 0 auto;
    padding: 1rem 1.25rem;
  }
  .entete {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    justify-content: space-between;
  }
  .marque {
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--couleur-texte);
  }
  .entete ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.2;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .pied {
    margin-top: 3rem;
    border-top: 1px solid #dde3ea;
    font-size: 0.9rem;
  }
  form {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-weight: 600;
  }
  input,
  textarea {
    padding: 0.6rem 0.7rem;
    font: inherit;
    border: 1px solid #b8c2cf;
    border-radius: 6px;
  }
  button {
    justify-self: start;
    padding: 0.7rem 1.4rem;
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: var(--couleur-accent);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
  .message-formulaire {
    padding: 0.8rem 1rem;
    border-radius: 6px;
    background: var(--couleur-doux);
  }
  .message-formulaire[data-etat='erreur'] {
    background: #fde8e8;
  }
</style>
